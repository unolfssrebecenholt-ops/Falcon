FALCON_GPT_BASE_URL=https://your-gpt55-relay.example.com
FALCON_GPT_ENDPOINT=/v1/chat/completions
FALCON_GPT_API_KEY=replace-with-your-key
FALCON_GPT_MODEL=gpt-5.5
FALCON_GPT_TIMEOUT=180

FALCON_IMAGE2_PRIMARY_BASE_URL=https://your-primary-image2-relay.example.com
FALCON_IMAGE2_PRIMARY_API_KEY=replace-with-your-primary-image2-key
FALCON_IMAGE2_FALLBACK_BASE_URL=https://your-fallback-image2-relay.example.com
FALCON_IMAGE2_FALLBACK_API_KEY=replace-with-your-fallback-image2-key
FALCON_IMAGE2_ENDPOINT=/v1/images/generations
FALCON_IMAGE2_MODEL=gpt-image-2
FALCON_IMAGE2_TIMEOUT=90
FALCON_IMAGE2_SIZE=1536x1024
